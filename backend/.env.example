# Safe defaults: stub mode is offline. For Colab, set LLM_PROVIDER=local_finetuned,
# STUB_MODE=false, SDLC_AGENT_ENABLED=true, and add the current ngrok URL below.
STUB_MODE=true
PHASE2_ENABLED=false
# Enable the secondary classification, conflict, clarification, compliance,
# security/privacy, and risk agents when desired.
OPTIONAL_ANALYSIS_AGENTS_ENABLED=false
# Phase 3 is deterministic and runs without an API key.
PHASE3_ENABLED=true
# Optional legacy LLM narration; separate from the SDLC analysis agent.
PHASE3_NARRATION_ENABLED=false
# Optional SDLC analysis agent served by the local_finetuned Colab endpoint.
SDLC_AGENT_ENABLED=false
PHASE4_ENABLED=true
PHASE4_MAX_REVIEW_ROUNDS=2
# Client runs return extracted requirements and SDLC results directly.
# Set true only to enable a separate internal reviewer interrupt workflow.
REVIEWER_APPROVAL_REQUIRED=false
COMPLIANCE_MIN_CONFIDENCE=0.55
CLARIFICATION_MAX_ROUNDS=3

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/loan_origination
ANTHROPIC_API_KEY=
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
LLM_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
HF_COLAB_ENDPOINT_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120

APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
